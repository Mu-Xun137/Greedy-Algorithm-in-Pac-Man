# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
/.venv*/
/venv/
/env/
/ENV/

# Local game saves, high scores and preferences
/.save/

# Local environment configuration (keep example files)
.env
.env.*
!.env.example
!.env.*.example

# Test, lint and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python packaging and executable build output
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Intermediate animation frames; keep the published GIFs and posters
/artifacts/learning/frames/

# Optional local ROM inputs
/roms/
pacman.6e
pacman.6f

# Logs, editor files and OS metadata
*.log
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
